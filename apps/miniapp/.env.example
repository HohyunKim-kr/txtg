# testnet | mainnet
VITE_NETWORK=testnet

# Privy app id (dashboard.privy.io). Empty → dev wallet (testnet only, key kept in this browser).
VITE_PRIVY_APP_ID=

# Builder code. Empty → orders go out without a builder fee and the approval step is skipped.
VITE_BUILDER_ADDRESS=
# Fee charged per order, in tenths of a basis point (10 = 0.01%). Perp cap is 100.
VITE_BUILDER_FEE=10
# Cap the user approves. Must be >= VITE_BUILDER_FEE.
VITE_BUILDER_MAX_FEE_RATE=0.05%
