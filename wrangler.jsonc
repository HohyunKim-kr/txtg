// Mini app assets and the English Telegram guide/market bot.
// Build first (`pnpm run build`), then `npx wrangler deploy` uploads apps/miniapp/dist.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "txgram",
  "main": "./apps/bot/src/worker.ts",
  "compatibility_date": "2026-10-01",
  "vars": {
    "MINIAPP_URL": "https://txgram.txgram.workers.dev",
    "TXFLOW_NETWORK": "testnet"
  },
  "assets": {
    "directory": "./apps/miniapp/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  }
}
