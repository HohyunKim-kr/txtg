{
  "name": "txgram",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.1",
  "scripts": {
    "dev": "pnpm --filter @txgram/miniapp dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "bot:setup": "pnpm --filter @txgram/scripts bot:setup",
    "worker:dev": "wrangler dev",
    "worker:check": "wrangler deploy --dry-run"
  },
  "devDependencies": {
    "wrangler": "^4.152.0"
  },
  "engines": {
    "node": ">=22"
  }
}
